{
  "uid": "nerdnam-service",
  "title": "nerdnam 서비스",
  "description": "BE 요청·AI 작업·임베딩·Pod 상태. 알림 규칙(gitops/observability/templates/rules.yaml)과 같은 지표를 본다.",
  "tags": [
    "nerdnam"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "상태",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "BE 수집",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{namespace=\"nerdnam\", job=\"api\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "0 이면 BE 가 죽었거나 Prometheus 가 관리 포트(8081)에 닿지 못한다",
      "id": 2
    },
    {
      "type": "stat",
      "title": "요청/초",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"nerdnam\", job=\"api\", uri!~\"/actuator.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "stat",
      "title": "5xx 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
