    {
      "type": "timeseries",
      "title": "노드 CPU 사용률 (역할별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate) / on (node) kube_node_status_allocatable{resource=\"cpu\"} * on (node) group_left(label_workload) kube_node_labels",
          "legendFormat": "{{label_workload}} {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "노드 위 Pod 사용량 합 / allocatable. app 노드는 web·api·ai·Traefik, data 노드는 PostgreSQL·Redis.",
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "노드 메모리 사용률 (역할별)",
