          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"nerdnam|data|traefik\", container!=\"\"}[1m])) / sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=~\"nerdnam|data|traefik\", resource=\"cpu\"})",
