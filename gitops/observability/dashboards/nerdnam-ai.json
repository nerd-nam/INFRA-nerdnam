      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operation, result) (rate(nerdnam_ai_bedrock_calls_total{namespace=\"nerdnam\", job=\"ai\"}[1m])) * 60",
          "legendFormat": "{{operation}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "converse = LLM(Nova), invoke_model = 임베딩(Titan). throttle 이 오르면 Bedrock 분당 한도\n점선 20 = Nova(converse), 60 = Titan(invoke_model) 분당 한도 근처. A: invoke_model ok 가 60 근처에서 평평. B: converse throttle 이 오르고 ok 가 20~30 근처.",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "재시도 비율 (시도 ÷ 호출)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operation) (rate(nerdnam_ai_bedrock_attempts_total{namespace=\"nerdnam\", job=\"ai\"}[1m])) / sum by (operation) (rate(nerdnam_ai_bedrock_calls_total{namespace=\"nerdnam\", job=\"ai\"}[1m]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "1 이면 재시도 없음. 1 보다 크면 Bedrock 이 throttle 을 걸고 AI 서버가 다시 보내는 중\nA: invoke_model 이 1 보다 커짐. B: converse 가 1 보다 커짐(11-03 약 2배).",
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "대기열 대기 p95·거절",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
