{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nerdnam-terraform-082139775699-ap-northeast-2-an"
    },
    {
      "Sid": "ReadWriteDevState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::nerdnam-terraform-082139775699-ap-northeast-2-an/dev/bootstrap.tfstate"
    },
    {
      "Sid": "ManageDevStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::nerdnam-terraform-082139775699-ap-northeast-2-an/dev/bootstrap.tfstate.tflock"
    }
  ]
}
