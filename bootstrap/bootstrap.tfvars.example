# 실제 환경 입력값은 ignored *.tfvars에 저장한다.
# git_revision 은 기본값 main 을 쓴다. 장애 때 특정 commit 에 잠시 고정할 때만 넣는다.
sample_hostname = "sample.example.com"
app_hostname = "nerdnam.example.com"
acme_email = "ops@example.com"
# 발급 시험은 staging endpoint 사용 가능 (브라우저가 신뢰하지 않는 인증서).
# acme_server = "https://acme-staging-v02.api.letsencrypt.org/directory"
